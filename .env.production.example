# Production environment template.
#
# Copy this file to `.env.production` on the production server and fill in
# real values. `.env.production` is git-ignored and must never be committed.
#
# Used by: docker-compose.yml (via `env_file`, profile "production") for both
# the `db` and `app` services.

# --- Database (PostgreSQL) ---------------------------------------------
# Credentials for the `db` service container (postgres:16 image).
# Change these from the defaults before first deployment.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=insurance_system_db

# Connection string used by the app (Prisma). Host must be the Docker
# Compose service name "db", not localhost, since the app talks to
# Postgres over the internal Compose network.
DATABASE_URL="postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@db:5432/insurance_system_db?schema=public"

# --- Authentication (NextAuth) -----------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_RANDOM_32_BYTE_SECRET

# Public production URL (used for callback URLs, cookies, etc.)
NEXTAUTH_URL=https://insurance.enfbgroup.com

# --- Application ---------------------------------------------------------
NODE_ENV=production

# Internal container port. Must match the Dockerfile EXPOSE/HEALTHCHECK
# (3000) and the docker-compose port mapping (127.0.0.1:3001:3000).
PORT=3000

# --- Customer document storage (LocalStorageProvider) -------------------
# Path inside the container. Must match the docker-compose volume mount
# target (./uploads:/app/uploads) so uploaded files persist across
# `docker compose down`/`up` and image rebuilds.
UPLOADS_DIR=/app/uploads

# Maximum upload size per file, in megabytes.
MAX_UPLOAD_FILE_SIZE_MB=20

# --- Dropbox Integration (Settings > Dropbox) ----------------------------
# Scoped App, OAuth 2 Authorization Code flow with offline access (refresh
# tokens) — never the manually-generated access token from the Dropbox
# developer console. See src/lib/integrations/dropbox/.
#
# App Key/Secret come from the Dropbox App Console for the configured app.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Must exactly match one of the redirect URIs configured on the Dropbox
# app (production: https://insurance.enfbgroup.com/api/integrations/dropbox/callback).
DROPBOX_REDIRECT_URI=https://insurance.enfbgroup.com/api/integrations/dropbox/callback

# 32-byte AES-256-GCM key, base64-encoded, used only to encrypt the stored
# Dropbox refresh token (never the App Secret, never a password).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DROPBOX_TOKEN_ENCRYPTION_KEY=

# --- Production Initialization (Settings > System, ADMIN-only) ----------
# Master switch for the "permanently clear all business data, keep users/
# settings/Dropbox connection" feature. Must be the exact string "true" —
# anything else (unset, "false", "TRUE", "1", "yes", ...) keeps it fully
# disabled: the UI entry point does not render, and both API routes return
# 404 regardless of who's asking. See src/lib/productionInit/.
#
# Recommended default: leave at "false" (or unset). Set to "true" only for
# the brief window an admin is actually running the one-time production
# go-live data wipe, then set back to "false" and restart the app.
ENABLE_PRODUCTION_INITIALIZATION=false
