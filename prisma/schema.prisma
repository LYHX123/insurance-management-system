// =============================================================================
// Policy Management — Phase 1A: Motor
// =============================================================================
// PolicyRecord is the common parent across every future Policy category
// (Motor now; Non-Motor/Bond/Work Permit later — each gets its own
// *PolicyDetail model the same way Motor does here, following the
// QuotationInsuranceSection -> *SectionDetail pattern already established
// above). category discriminates which detail relation is populated;
// exactly one of MotorPolicyDetail (for now) is expected per PolicyRecord.

enum PolicyCategory {
  MOTOR
  NON_MOTOR
  BOND
  WORK_PERMIT
}

// DRAFT: future effective date, not yet on cover. ACTIVE: today falls inside
// [effectiveDate, expiryDate]. EXPIRED: expiryDate has passed. CANCELLED: set
// explicitly (never inferred from dates alone — see historical import's
// "Cancel" remarks handling in scripts/backfill/import logic). RENEWED is
// reserved for a future renewal workflow (Phase 1A never assigns it).
enum PolicyBusinessStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED
  RENEWED
}

// Mirrors RevisionStatus/QuotationCaseStatus's pattern of a small, explicit
// enum per lifecycle concept rather than reusing QuotationStatus.
enum PolicyRecordSource {
  MANUAL
  HISTORICAL_IMPORT
}

enum PolicyPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  FULLY_PAID
  OVERPAID
}

// Phase 1A.1: some historical balance cells (ACCOUNT PAYABLE / ACCOUNTS
// RECEIVABLE) are unreadable at the source — a broken self-referencing
// formula, a genuinely blank cell, or some other unparseable value. Those
// rows are never silently treated as a verified zero/blank balance; they
// carry UNVERIFIED + a reason all the way from the import preview onto the
// resulting PolicyRecord, so its Financial tab keeps showing the warning
// until someone manually resolves it.
enum PolicyBalanceVerificationStatus {
  VERIFIED
  UNVERIFIED
}

enum PolicyBalanceWarningReason {
  BROKEN_SOURCE_FORMULA
  BLANK_SOURCE_BALANCE
  OTHER_UNREADABLE_BALANCE
}

// Atomic per-category-month counter backing the PM{YYYYMM}-{seq} (Motor),
// PN.../PB.../PW... record number formats — same INSERT ... ON CONFLICT DO
// UPDATE pattern as QuotationNumberCounter, keyed by category so each
// category's sequence is independent.
model PolicyRecordNumberCounter {
  key          String @id
  lastSequence Int    @default(0)
}

model PolicyRecord {
  id             String           @id @default(cuid())
  recordNumber   String           @unique
  category       PolicyCategory
  processingDate DateTime
  customerId     String
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  projectId      String?
  project        CustomerProject? @relation(fields: [projectId], references: [id], onDelete: Restrict)

  // Nullable: about 2% of historical Motor rows have no insurer recorded at
  // all (see the Phase 1A import inspection report) — this is real, existing
  // data quality, not something the schema should force-fix.
  insurerName    String?
  effectiveDate  DateTime
  expiryDate     DateTime
  businessStatus PolicyBusinessStatus @default(DRAFT)
  currency       String               @default("KES")

  // "Client Premium" / "Insurer Cost" in the historical workbook — the two
  // headline amounts every category shares. Category-specific inputs behind
  // these totals (vehicle value, cover type, ...) live on the detail model.
  customerPremium Decimal @db.Decimal(16, 2)
  insurerCost     Decimal @db.Decimal(16, 2)

  // Phase 1A commission fields (commissionReceived/commissionReceivedDate)
  // stayed intentionally coarse because the historical COMMISSION column is
  // almost always blank, with a few inconsistent values (YES/Y/N/a bare rate
  // like 0.12). Phase 1B adds commissionAmount for the same reason it never
  // added the others sooner: manually-created/edited records can now record
  // a real received amount, but this is still deliberately just one flat
  // amount — no installment history, no separate transaction table (see
  // updateCommissionAction's doc comment). Business rule (enforced only in
  // that action, not at the DB level): commissionReceived=false requires
  // commissionAmount/commissionReceivedDate both null; =true requires both
  // set with commissionAmount >= 0.
  commissionReceived     Boolean   @default(false)
  commissionAmount       Decimal?  @db.Decimal(16, 2)
  commissionReceivedDate DateTime?
  // Historical NET PROFIT column value, when the workbook actually had one
  // (it was blank for every row inspected in this phase, but the field
  // exists for future imports/categories that do carry it). Never computed,
  // never overwritten — see "System Calculated Margin" for the live figure.
  historicalNetProfit    Decimal?  @db.Decimal(16, 2)

  // Phase 1A.1: carried over from the PolicyImportRow that created this
  // record (see PolicyImportRow's matching fields below) — VERIFIED/null
  // for every manually-created record and every historical row whose
  // balance was actually readable; UNVERIFIED + a reason only for the rare
  // row where the source balance itself could not be trusted.
  insurerBalanceVerification  PolicyBalanceVerificationStatus @default(VERIFIED)
  insurerBalanceWarningReason PolicyBalanceWarningReason?
  clientBalanceVerification   PolicyBalanceVerificationStatus @default(VERIFIED)
  clientBalanceWarningReason  PolicyBalanceWarningReason?

  // Phase 1A.2: manual resolution audit trail — set only by
  // resolveBalanceVerificationAction, once per side. insurerBalanceWarningReason
  // above is deliberately left untouched when resolving (never cleared), so
  // "this was originally BLANK_SOURCE_BALANCE, and was manually verified on
  // <date> by <user>" both remain visible — see this action's doc comment.
  insurerBalanceResolutionNote String?
  insurerBalanceResolvedAt     DateTime?
  insurerBalanceResolvedById   String?
  clientBalanceResolutionNote  String?
  clientBalanceResolvedAt      DateTime?
  clientBalanceResolvedById    String?

  source            PolicyRecordSource @default(MANUAL)
  importBatchId     String?
  importBatch       PolicyImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  sourceSheet       String?
  originalRowNumber Int?

  // --- Phase 2A: Quotation -> PolicyRecord relationship -------------------
  // Optional reference to the specific Quotation revision this policy was
  // created from — never required (manual creation and historical import
  // both leave this null forever) and never one-to-one (many PolicyRecords
  // may point at the same Quotation: one per vehicle/section). onDelete:
  // SetNull rather than Restrict at the DB level because the app layer
  // already blocks deleting a revision/quotation that still has linked
  // policies with a friendly error (see deleteDraftRevisionAction and
  // deleteQuotationAction) — this is just a defensive fallback so a policy
  // record itself is never lost if that guard is ever bypassed.
  sourceQuotationId String?
  sourceQuotation   Quotation? @relation(fields: [sourceQuotationId], references: [id], onDelete: SetNull)

  // Phase 2B: immutable audit snapshot of the source quotation, written once
  // at creation time alongside sourceQuotationId and never refreshed
  // afterward — so the origin stays understandable even if the quotation is
  // later edited, superseded, or (should the SetNull fallback above ever
  // fire) removed entirely. sourceQuotationId + the live relation remain the
  // authoritative navigation link while they exist; these three fields are
  // reference-only and are never read as authoritative premium/status data.
  // Null for every manually-created and every historical-import record —
  // only createMotorRecordAction's quotation-linked path ever sets them.
  sourceQuotationNumberSnapshot   String?
  sourceQuotationRevisionSnapshot String?
  sourceQuotationDateSnapshot     DateTime?

  remarks String?

  createdById String
  createdAt   DateTime  @default(now())
  updatedById String?
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  motorDetail      MotorPolicyDetail?
  nonMotorDetail   NonMotorPolicyDetail?
  bondDetail       BondPolicyDetail?
  workPermitDetail WorkPermitPolicyDetail?
  customerReceipts PolicyCustomerReceipt[]
  providerPayments PolicyProviderPayment[]
  documents        PolicyDocument[]
  activities       PolicyActivity[]
  invoiceItems     InvoiceItem[]

  // Dropbox Integration Phase 7 — the optional, explicit, user-selected
  // link a Motor/Non-Motor Claim may have to this Policy (see
  // MotorClaim.policyRecordId/NonMotorClaim.policyRecordId's own doc
  // comments). Never auto-linked/guessed; purely for the user-facing
  // "Linked Policy" selector and Claim Dropbox business-folder reuse.
  motorClaims    MotorClaim[]
  nonMotorClaims NonMotorClaim[]

  // Dropbox Integration Phase 5 — only present for a Policy that has no
  // linked QuotationCase business file (see PolicyDropboxBusinessFile's own
  // doc comment); a linked Policy resolves its business file through
  // sourceQuotation.quotationCase.dropboxBusinessFile instead and this
  // relation stays null forever for it.
  dropboxBusinessFile PolicyDropboxBusinessFile?

  @@index([category])
  @@index([customerId])
  @@index([projectId])
  @@index([businessStatus])
  @@index([expiryDate])
  @@index([importBatchId])
  @@index([deletedAt])
  @@index([sourceQuotationId])
}

// Fixed, small, closed classification (unlike insuranceType below, which is
// deliberately an open string list) — a real Prisma enum since "what kind of
// vehicle use is this" only ever has these four business-defined answers,
// with no history of previously-unseen values the way cover type had.
enum MotorTaxClass {
  PRIVATE
  COMMERCIAL
  SPV
  SPECIAL_USE
}

// One detail model per category, same pattern as QuotationInsuranceSection's
// *SectionDetail models. insuranceType is a plain string (not an enum) —
// Phase 1A's inspection found exactly six clean, real values in the
// historical data (COMPREHENSIVE, THIRD PARTY, COMESA, EXCESS, EXCESS
// PROTECTOR, VALUATION); a DB enum would force a migration for every future
// cover-type variant, whereas the app validates against a known-values list
// instead (see src/lib/policy/motorCoverTypes.ts).
model MotorPolicyDetail {
  id             String       @id @default(cuid())
  policyRecordId String       @unique
  policyRecord   PolicyRecord @relation(fields: [policyRecordId], references: [id], onDelete: Cascade)

  insuranceType      String
  registrationNumber String
  // Nullable: ~46% of historical rows have no vehicle value — overwhelmingly
  // THIRD PARTY/COMESA covers, where this business never records one. See
  // this phase's inspection report for the exact breakdown.
  vehicleValue       Decimal?       @db.Decimal(18, 2)
  // The historical ledger has no policy-number column at all — never
  // required for imported rows; only future manually-created records may
  // supply one.
  policyNumber       String?
  vehicleMake        String?
  vehicleModel       String?
  // Nullable for backward compatibility only: every historical-import row
  // and every Motor record created before this field existed has (and keeps)
  // taxClass = null, shown as "Not specified" in the UI until someone edits
  // that record. Never guessed/inferred from insuranceType or anything else
  // (see this field's app-level validation in createMotorRecordAction /
  // updateMotorOverviewAction, which requires a real value for every new
  // manual/quotation-linked creation and every general policy edit going
  // forward — the DB-level nullability only exists for the legacy rows that
  // predate this field).
  taxClass           MotorTaxClass?

  @@index([registrationNumber])
  @@index([insuranceType])
}

// Fixed set of Non-Motor insurance types on this business's quotation
// template, excluding Motor (its own category), Bond, and Work Permit
// (future categories). Mirrors QuotationSectionKind's non-Motor/non-Bond
// values 1:1 for quotation-linkage section matching — see
// createNonMotorRecordAction's doc comment.
enum NonMotorCoverType {
  CONTRACTORS_ALL_RISKS
  WIBA
  EMPLOYERS_LIABILITY
  CONTRACTORS_PLANT_MACHINERY
  PUBLIC_LIABILITY
  FIRE_ALLIED_PERILS
  BURGLARY
  GOODS_IN_TRANSIT_SINGLE
  GOODS_IN_TRANSIT_ANNUAL
  MARINE
  GROUP_PERSONAL_ACCIDENT
  GROUP_MEDICAL
}

// Phase 3A: Non-Motor's *PolicyDetail model, following the same
// PolicyRecord -> one-detail-model-per-category pattern as
// MotorPolicyDetail above. Every shared/operational field (processing date,
// customer, project, insurer, effective/expiry date, premiums, commission,
// remarks, source quotation) stays on PolicyRecord — this model holds only
// what's genuinely Non-Motor-specific, so it's deliberately much smaller
// than MotorPolicyDetail.
model NonMotorPolicyDetail {
  id             String       @id @default(cuid())
  policyRecordId String       @unique
  policyRecord   PolicyRecord @relation(fields: [policyRecordId], references: [id], onDelete: Cascade)

  insuranceType NonMotorCoverType
  // Optional, same reasoning as MotorPolicyDetail.policyNumber — not every
  // policy has one recorded yet at creation time.
  policyNumber  String?

  @@index([insuranceType])
}

// Fixed, small, closed classification — mirrors the four structured Bond
// QuotationSectionKind values (TENDER_SECURITY, PERFORMANCE_BOND,
// ADVANCE_PAYMENT_GUARANTEE, CUSTOMS_BOND) 1:1 in spirit, but named per the
// business's requested Policy-side wording rather than reusing the
// Quotation-side enum directly (Policy and Quotation are allowed to diverge
// in naming; see createNonMotorRecordAction's own section-kind-to-cover-type
// mapping precedent for why a translation layer, not a shared enum, is used
// at the quotation-linkage boundary).
enum BondType {
  TENDER_BOND
  PERFORMANCE_BOND
  ADVANCE_PAYMENT_GUARANTEE
  CUSTOM_BOND
}

// Phase 3B: Bond's *PolicyDetail model, following the same
// PolicyRecord -> one-detail-model-per-category pattern as
// MotorPolicyDetail/NonMotorPolicyDetail above. Every shared/operational
// field (processing date, customer, project, insurer, effective/expiry
// date, premiums, commission, remarks, source quotation) stays on
// PolicyRecord — this model holds only what's genuinely Bond-specific.
model BondPolicyDetail {
  id             String       @id @default(cuid())
  policyRecordId String       @unique
  policyRecord   PolicyRecord @relation(fields: [policyRecordId], references: [id], onDelete: Cascade)

  bondType       BondType
  bondAmount     Decimal  @db.Decimal(16, 2)
  // Required only when bondType = CUSTOM_BOND, enforced app-side (see
  // createBondRecordAction / updateBondOverviewAction) — never set for any
  // other bondType, mirroring MotorPolicyDetail.taxClass's app-level-only
  // conditional-requirement precedent.
  customBondType String?
  // Optional, same reasoning as MotorPolicyDetail.policyNumber.
  policyNumber   String?

  @@index([bondType])
}

// Greenfield category (Phase 3B) — no existing Kenyan work-permit
// terminology or QuotationSectionKind equivalent was found in this
// repository to reuse (see Phase 3B research notes), so this is the
// business's minimal practical set requested for this phase. Confirm with
// the business before extending.
enum WorkPermitType {
  CLASS_D
  CLASS_G
  SPECIAL_PASS
  DEPENDANT_PASS
  OTHER
}

// Phase 3B: Work Permit's *PolicyDetail model, same pattern as the other
// categories. Deliberately reuses PolicyRecord.insurerCost as the "Agent
// Cost" internally (see createWorkPermitRecordAction's doc comment) rather
// than adding a duplicate cost column, so the existing shared
// PolicyProviderPayment architecture (Add Payment / payment history / Total
// Paid / Balance) works unchanged — only the UI labels differ (Agent Cost /
// Agent Payments / Agent Balance instead of Insurer *).
model WorkPermitPolicyDetail {
  id             String       @id @default(cuid())
  policyRecordId String       @unique
  policyRecord   PolicyRecord @relation(fields: [policyRecordId], references: [id], onDelete: Cascade)

  permitType      WorkPermitType
  agent           String
  // Required only when permitType = OTHER, same conditional pattern as
  // BondPolicyDetail.customBondType — enforced app-side.
  otherPermitType String?
  // Optional, same reasoning as MotorPolicyDetail.policyNumber.
  permitNumber    String?

  @@index([permitType])
}

// Reusable child transaction models — deliberately never a single "amount
// paid" field on PolicyRecord itself, so a policy can accept any number of
// part-payments over time from either side (see this phase's architecture
// notes). Historical import creates at most one row per side per policy
// (from columns J/K and O/P respectively); everything created going forward
// through the UI can add as many as actually happened.
model PolicyCustomerReceipt {
  id             String       @id @default(cuid())
  policyRecordId String
  policyRecord   PolicyRecord @relation(fields: [policyRecordId], references: [id], onDelete: Cascade)

  receiptDate     DateTime
  amount          Decimal  @db.Decimal(16, 2)
  paymentMethod   String?
  referenceNumber String?
  notes           String?

  source            PolicyRecordSource @default(MANUAL)
  originalRowNumber Int?

  createdById String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([policyRecordId])
  @@index([deletedAt])
}

model PolicyProviderPayment {
  id             String       @id @default(cuid())
  policyRecordId String
  policyRecord   PolicyRecord @relation(fields: [policyRecordId], references: [id], onDelete: Cascade)

  paymentDate     DateTime
  amount          Decimal  @db.Decimal(16, 2)
  paymentMethod   String?
  referenceNumber String?
  notes           String?

  source            PolicyRecordSource @default(MANUAL)
  originalRowNumber Int?

  createdById String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([policyRecordId])
  @@index([deletedAt])
}

// --- Historical import staging ---------------------------------------------
// A real, persisted staging area (not just client-side/session state) between
// "user uploads a workbook" and "user confirms the import" — necessary since
// Next.js Server Actions are stateless per request and this is a multi-step,
// paginated review over ~1,400+ rows. PolicyImportRow rows are never
// deleted after a batch completes: they stay as the permanent audit trail of
// exactly what the source workbook said per row versus what was actually
// imported.

// PARTIALLY_IMPORTED (Phase 1A.2): the controlled "Import Selected"
// workflow imports only an explicit subset at a time, so a batch can sit
// indefinitely with some rows IMPORTED and others still READY/WARNING,
// waiting for a later selected-import run — COMPLETED is reserved for when
// no such eligible-but-not-yet-imported rows remain.
enum PolicyImportBatchStatus {
  UPLOADED
  PREVIEWED
  CONFIRMED
  PARTIALLY_IMPORTED
  COMPLETED
  FAILED
}

// POSSIBLE_DUPLICATE: shares a duplicate key (registration+effective,
// registration+expiry, or customer+registration+type+effective) with
// another row in this same batch — defaults to excluded, but the user can
// override and include it (a legitimate renewal or a second cover type on
// the same vehicle is a real, valid case, not necessarily a mistake).
// EXACT_DUPLICATE: an equivalent PolicyRecord already exists in the
// database (same source row already imported, or the same
// customer+registration+type+effective+expiry already has a real record) —
// always blocked, never overridable, see confirmMotorImportAction.
enum PolicyImportRowStatus {
  READY
  WARNING
  POSSIBLE_DUPLICATE
  EXACT_DUPLICATE
  ERROR
  IMPORTED
  SKIPPED
}

enum PolicyCustomerMatchStatus {
  MATCHED
  POSSIBLE
  MANUAL
  UNMATCHED
}

model PolicyImportBatch {
  id             String                  @id @default(cuid())
  category       PolicyCategory
  sourceFileName String
  // SHA-256 of the uploaded file bytes (see src/lib/quotationDocuments/storage.ts's
  // sha256Checksum, reused here) — an extra corroborating signal for "was
  // this exact file already imported", alongside the per-row
  // sourceSheet+originalRowNumber check that EXACT_DUPLICATE actually relies
  // on. Nullable so nothing breaks if hashing ever fails for a given upload.
  sourceFileHash String?
  sourceSheet    String
  status         PolicyImportBatchStatus @default(UPLOADED)
  totalRows      Int
  importedCount  Int                     @default(0)
  skippedCount   Int                     @default(0)
  errorCount     Int                     @default(0)

  createdById String
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  rows             PolicyImportRow[]
  policyRecords    PolicyRecord[]
  // Customers created directly from this batch's preview (see
  // createCustomersFromHistoricalNamesAction) — distinct from policyRecords
  // above, which are the actual imported policies.
  customersCreated Customer[]

  @@index([category])
  @@index([status])
}

// Flat, typed columns (not a JSON blob) mirroring this project's existing
// convention (every quotation section/detail row is flat and typed too) and
// matching the Phase 1A preview-table spec column-for-column, so the preview
// page can query and render this directly with no transformation layer.
model PolicyImportRow {
  id                String            @id @default(cuid())
  importBatchId     String
  importBatch       PolicyImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  originalRowNumber Int

  processingDate DateTime?

  customerNameRaw     String?
  matchedCustomerId   String?
  customerMatchStatus PolicyCustomerMatchStatus @default(UNMATCHED)

  insuranceType      String?
  registrationNumber String?
  insurerName        String?
  // Phase 3B: added for Non-Motor import (Motor's historical workbook has no
  // policy-number column, so this stays null for every Motor row). Same
  // "not required, informational only" role as MotorPolicyDetail.policyNumber.
  policyNumber       String?
  effectiveDate      DateTime?
  expiryDate         DateTime?

  // Phase 3B: added for Non-Motor import's optional PROJECT column. Raw text
  // preserved as-typed; matchedProjectId is set only when it resolves to an
  // exact, unambiguous CustomerProject belonging to the matched customer —
  // otherwise left null and the row still imports with project unset, same
  // "never guess" principle as customer matching's UNMATCHED/POSSIBLE split.
  projectNameRaw   String?
  matchedProjectId String?

  insurerCost                 Decimal?                        @db.Decimal(16, 2)
  amountPaidToInsurer         Decimal?                        @db.Decimal(16, 2)
  insurerPaymentDate          DateTime?
  calculatedInsurerBalance    Decimal?                        @db.Decimal(16, 2)
  // Historical ACCOUNT PAYABLE (column L) as found in the workbook, kept
  // verbatim for comparison — never silently reconciled against the
  // calculated value above (see this phase's balance-consistency findings).
  originalInsurerBalance      Decimal?                        @db.Decimal(16, 2)
  // Raw/cached text of the source cell when originalInsurerBalance above
  // couldn't be parsed into a number (e.g. a broken formula's literal text,
  // or "" for a genuinely blank cell) — audit trail for
  // insurerBalanceWarningReason below, since the numeric field alone can't
  // distinguish "blank" from "unreadable formula".
  originalInsurerBalanceRaw   String?
  insurerBalanceVerification  PolicyBalanceVerificationStatus @default(VERIFIED)
  insurerBalanceWarningReason PolicyBalanceWarningReason?

  clientPremium              Decimal?                        @db.Decimal(16, 2)
  amountReceivedFromClient   Decimal?                        @db.Decimal(16, 2)
  clientReceiptDate          DateTime?
  calculatedClientBalance    Decimal?                        @db.Decimal(16, 2)
  // Historical ACCOUNTS RECEIVABLE (column Q), same verbatim-preservation
  // rule as originalInsurerBalance above.
  originalClientBalance      Decimal?                        @db.Decimal(16, 2)
  originalClientBalanceRaw   String?
  clientBalanceVerification  PolicyBalanceVerificationStatus @default(VERIFIED)
  clientBalanceWarningReason PolicyBalanceWarningReason?

  vehicleValue Decimal? @db.Decimal(18, 2)

  commissionReceived     Boolean   @default(false)
  commissionReceivedDate DateTime?
  historicalNetProfit    Decimal?  @db.Decimal(16, 2)

  remarks String?

  // Within-batch POSSIBLE_DUPLICATE group members (see PolicyImportRowStatus).
  duplicateOfRowNumbers     Int[]                 @default([])
  // Set only for EXACT_DUPLICATE — the already-existing PolicyRecord this
  // row collides with. Plain unenforced id string (this project's existing
  // convention for informational cross-references — see e.g.
  // Quotation.createdBy), not a formal relation.
  duplicateOfPolicyRecordId String?
  status                    PolicyImportRowStatus @default(READY)
  warnings                  String[]              @default([])
  includeInImport           Boolean               @default(true)
  // Phase 1A.2: persisted selection state for the controlled "Import
  // Selected" workflow — deliberately a real DB column (not client-only
  // component state) so selection survives pagination/navigation and is the
  // one thing importSelectedRowsAction actually trusts (never the client's
  // in-memory list alone). Only ever true for a row that is currently
  // eligible (see the selection actions in
  // src/app/(app)/policy/motor/import/actions.ts); toggling a row
  // ineligible again (e.g. a customer mapping is reverted) also clears this.
  isSelectedForImport       Boolean               @default(false)

  createdAt DateTime @default(now())

  @@index([importBatchId])
  @@index([status])
}

// =============================================================================
// Phase 1B — Policy Documents and Activity Log
// =============================================================================
// PolicyDocument is shared across every Policy category (Motor now;
// Non-Motor/Bond/Work Permit later) — same reasoning as PolicyRecord itself:
// one model, no Motor-only document table, so a future category needs no
// schema change to get document support, only its own upload/list UI.

enum PolicyDocumentType {
  POLICY_SCHEDULE
  CERTIFICATE
  STICKER
  DEBIT_NOTE
  RECEIPT
  ENDORSEMENT
  CANCELLATION
  OTHER
}

// Mirrors DocumentStorageProvider's Phase 2/3 pattern already established
// for QuotationDocument: every Phase 1B document is LOCAL; DROPBOX is
// reserved for a future phase and must not be selectable or written by any
// code path yet (see src/lib/policyDocuments/storage.ts's doc comment).
enum PolicyDocumentStorageProvider {
  LOCAL
  DROPBOX
}

model PolicyDocument {
  id             String       @id @default(cuid())
  policyRecordId String
  policyRecord   PolicyRecord @relation(fields: [policyRecordId], references: [id], onDelete: Cascade)

  documentType     PolicyDocumentType
  originalFileName String
  storedFileName   String
  mimeType         String
  fileSize         Int

  storageProvider PolicyDocumentStorageProvider @default(LOCAL)
  storagePath     String
  // Reserved for the future Dropbox implementation
  // (src/lib/policyDocuments/storage.ts's PolicyDocumentStorage interface) —
  // never written by any Phase 1B code path.
  externalFileId  String?
  externalPath    String?

  issueDate  DateTime?
  expiryDate DateTime?
  notes      String?

  uploadedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Dropbox Integration Phase 5 — dedicated sync-status row, same
  // one-row-per-document convention as CustomerDocumentDropboxSync (Phase
  // 3). Optional: existing documents have no row until backfilled.
  dropboxSync PolicyDocumentDropboxSync?

  @@index([policyRecordId])
  @@index([documentType])
}

// Dropbox Integration Phase 5 — distinguishes which of the two business-file
// tables a PolicyDocumentDropboxSync row's businessFileId points at. Plain,
// unenforced id + this discriminator (this project's existing convention for
// a cross-table reference — see e.g. PolicyActivity.performedById) rather
// than two nullable FK columns, since exactly one of the two business-file
// kinds ever applies to a given Policy.
enum PolicyDropboxBusinessFileSource {
  QUOTATION_CASE
  POLICY_FALLBACK
}

// Dropbox Integration Phase 5 — one row per PolicyRecord that has NO linked
// QuotationCase (sourceQuotationId is null, or its source Quotation's case
// has no business file of its own to reuse — see
// src/lib/integrations/dropbox/policyBusinessFile.ts). A linked Policy never
// gets a row here; it resolves its business file through
// sourceQuotation.quotationCase.dropboxBusinessFile instead (Part 3,
// requirement 1: never a second, duplicate business folder). Created the
// first time a Policy document is synchronized for an unlinked Policy —
// same lazy-creation convention as QuotationDropboxBusinessFile. Stores an
// IMMUTABLE naming snapshot, same reasoning as QuotationDropboxBusinessFile
// (Part 3, requirement 8: "store immutable naming snapshots").
model PolicyDropboxBusinessFile {
  id             String       @id @default(cuid())
  policyRecordId String       @unique
  policyRecord   PolicyRecord @relation(fields: [policyRecordId], references: [id], onDelete: Cascade)

  businessDate       DateTime
  insuranceTypeCode  String
  customerShortName  String
  businessTitle      String
  businessFolderName String

  dropboxFolderId    String?
  dropboxDisplayPath String?
  dropboxPathLower   String?

  syncStatus        DropboxBusinessFileSyncStatus @default(PENDING)
  lastSyncAttemptAt DateTime?
  lastSyncedAt      DateTime?
  lastErrorCode     String?
  lastErrorMessage  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([syncStatus])
}

// Dropbox Integration Phase 5 — one row per PolicyDocument, same dedicated
// sync-metadata convention as CustomerDocumentDropboxSync/
// QuotationDropboxVersion. businessFileId/businessFileSource record which
// business file (a QuotationCase's shared one, or this Policy's own
// fallback) this document was filed under, so retries never need to
// re-derive/guess the relationship (Part 3, requirement 2).
model PolicyDocumentDropboxSync {
  id               String         @id @default(cuid())
  policyDocumentId String         @unique
  policyDocument   PolicyDocument @relation(fields: [policyDocumentId], references: [id], onDelete: Cascade)

  businessFileId     String?
  businessFileSource PolicyDropboxBusinessFileSource?

  standardizedFileName String
  originalFileName     String

  dropboxFileId      String?
  dropboxRevision    String?
  dropboxDisplayPath String?
  dropboxPathLower   String?
  dropboxContentHash String?
  dropboxSize        BigInt?

  syncStatus        DropboxDocumentSyncStatus @default(PENDING)
  lastSyncAttemptAt DateTime?
  lastSyncedAt      DateTime?
  lastErrorCode     String?
  lastErrorMessage  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([syncStatus])
  @@index([businessFileId])
}

// One entry per action listed in updatePolicyActivity's doc comment
// (src/lib/policy/activity.ts) — append-only from the UI's perspective (no
// edit/delete action is ever exposed for these rows).
enum PolicyActivityActionType {
  POLICY_CREATED
  POLICY_UPDATED
  POLICY_CANCELLED
  CUSTOMER_RECEIPT_ADDED
  INSURER_PAYMENT_ADDED
  COMMISSION_UPDATED
  DOCUMENT_UPLOADED
  DOCUMENT_DELETED
  BALANCE_VERIFIED
  HISTORICAL_POLICY_IMPORTED
  // Phase 4A: Invoice lifecycle events, logged onto every Policy linked to
  // the Invoice — see recordPolicyActivity calls in
  // src/app/(app)/invoice/actions.ts.
  INVOICE_ISSUED
  INVOICE_CANCELLED
}

model PolicyActivity {
  id             String       @id @default(cuid())
  policyRecordId String
  policyRecord   PolicyRecord @relation(fields: [policyRecordId], references: [id], onDelete: Cascade)

  actionType PolicyActivityActionType
  // A single, already-human-readable sentence (see recordPolicyActivity's
  // examples) — this project's established convention is flat, typed
  // columns rather than a JSON blob (no model anywhere in this schema uses
  // Json), so structured extras go in this optional plain-text field
  // instead of a metadata JSON column.
  summary    String
  details    String?

  // Plain unenforced id string, this project's existing convention for a
  // single user reference (see e.g. Quotation.createdBy) — nullable since a
  // future system-triggered event might have no acting user.
  performedById String?
  createdAt     DateTime @default(now())

  @@index([policyRecordId])
  @@index([createdAt])
}

// =============================================================================
// Phase 4A: Invoice — a client-facing billing document generated from one or
// more of that customer's Policy records. Deliberately minimal in this
// phase (see Invoice.status's comment): no payment/outstanding-balance
// tracking here — that is future Ledger integration's job, not Invoice's.
// =============================================================================

// Same per-yearMonth atomic-counter pattern as QuotationNumberCounter (see
// generateQuotationNumber in src/lib/quotation-utils.ts) — a dedicated
// counter table rather than reusing PolicyRecordNumberCounter, since an
// Invoice is not a PolicyCategory and mixing an "INV" key into that
// category-keyed table would be a confusing overload of its purpose.
model InvoiceNumberCounter {
  yearMonth    String @id
  lastSequence Int    @default(0)
}

enum InvoiceStatus {
  ISSUED
  CANCELLED
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  invoiceDate   DateTime
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status        InvoiceStatus @default(ISSUED)
  totalPremium  Decimal       @db.Decimal(16, 2)

  // Populated once the generated workbook is durably saved to
  // InvoiceDocumentStorage (see src/lib/invoiceDocuments/storage.ts) — both
  // null only in the narrow window inside createInvoiceAction between the
  // Invoice row being created and the file save completing; if the file
  // save fails, the whole Invoice row is rolled back rather than ever being
  // left issued with no downloadable file (see that action's doc comment).
  generatedFileName    String?
  generatedStoragePath String?

  // Plain unenforced id string, this project's existing convention for a
  // single user reference (see PolicyActivity.performedById above).
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cancelledAt   DateTime?
  cancelledById String?

  items InvoiceItem[]

  // Dropbox Integration Phase 6 — see InvoiceDropboxBusinessFile/
  // InvoiceDocumentDropboxSync's own doc comments below.
  dropboxBusinessFile InvoiceDropboxBusinessFile?
  dropboxSync         InvoiceDocumentDropboxSync?

  @@index([customerId])
  @@index([status])
  @@index([invoiceDate])
}

// One row per Policy included on an Invoice. Deliberately NOT a duplicate of
// PolicyRecord — only the three fields that actually appear on the printed
// invoice are snapshotted, frozen at generation time, so an issued Invoice
// never silently changes if the source Policy is edited afterward (see
// Invoice's own top-of-model comment). premiumSnapshot is copied from
// PolicyRecord.customerPremium ("Client Premium") at creation time, never
// recomputed.
model InvoiceItem {
  id             String       @id @default(cuid())
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  policyRecordId String
  policyRecord   PolicyRecord @relation(fields: [policyRecordId], references: [id], onDelete: Restrict)

  itemNumber           Int
  policyClassSnapshot  String
  policyNumberSnapshot String
  premiumSnapshot      Decimal @db.Decimal(16, 2)

  createdAt DateTime @default(now())

  // A given Policy may appear at most once per Invoice — NOT a global
  // uniqueness constraint (see getEligiblePoliciesForCustomer's doc comment
  // in src/lib/invoice/eligibility.ts): a Policy can accumulate one
  // InvoiceItem row per CANCELLED invoice attempt over time, plus at most
  // one row belonging to a currently-ISSUED invoice, which is enforced at
  // the application layer (see createInvoiceAction), not by a DB constraint,
  // since the DB cannot see other rows' Invoice.status.
  @@unique([invoiceId, policyRecordId])
  @@index([policyRecordId])
}

// Dropbox Integration Phase 6 — distinguishes which business-file table an
// InvoiceDocumentDropboxSync row's businessFileId points at. Deliberately a
// separate enum from PolicyDropboxBusinessFileSource (not that enum plus a
// third member): an Invoice's business-file resolution is not a peer of
// Policy's QUOTATION_CASE/POLICY_FALLBACK binary — see
// src/lib/integrations/dropbox/invoiceBusinessFile.ts's doc comment for why
// (an Invoice can bundle multiple PolicyRecords via InvoiceItem, unlike a
// Policy's single sourceQuotation, so "the Policy's business folder" is only
// well-defined when an Invoice has exactly one linked Policy).
enum InvoiceDropboxBusinessFileSource {
  QUOTATION_CASE
  POLICY_FALLBACK
  INVOICE_FALLBACK
}

// Dropbox Integration Phase 6 — one row per Invoice that has NO single
// resolvable Policy/QuotationCase business folder to reuse (zero or 2+
// linked PolicyRecords via InvoiceItem — see invoiceBusinessFile.ts). An
// Invoice with exactly one linked Policy never gets a row here; it resolves
// its business file through that Policy's own resolver instead (reusing
// QuotationDropboxBusinessFile or PolicyDropboxBusinessFile — Part 2,
// requirement 1: never a second, duplicate business folder for the same
// insurance transaction). Created lazily the first time an Invoice is
// synchronized without a single resolvable Policy. Stores an IMMUTABLE
// naming snapshot, same reasoning/shape as PolicyDropboxBusinessFile/
// QuotationDropboxBusinessFile.
model InvoiceDropboxBusinessFile {
  id        String  @id @default(cuid())
  invoiceId String  @unique
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  businessDate       DateTime
  insuranceTypeCode  String
  customerShortName  String
  businessTitle      String
  businessFolderName String

  dropboxFolderId    String?
  dropboxDisplayPath String?
  dropboxPathLower   String?

  syncStatus        DropboxBusinessFileSyncStatus @default(PENDING)
  lastSyncAttemptAt DateTime?
  lastSyncedAt      DateTime?
  lastErrorCode     String?
  lastErrorMessage  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([syncStatus])
}

// Dropbox Integration Phase 6 — one row per Invoice's single generated
// document (an Invoice has exactly one generated file for its whole
// lifetime — no revision/regeneration concept exists in this schema, unlike
// QuotationDropboxVersion's many-versions-per-case shape — so this mirrors
// PolicyDocumentDropboxSync's one-row-per-document convention, not
// QuotationDropboxVersion's). businessFileId/businessFileSource record
// which business file (a reused QuotationCase/Policy one, or this Invoice's
// own INVOICE_FALLBACK) this file was filed under, so retries never need to
// re-derive/guess the relationship.
model InvoiceDocumentDropboxSync {
  id        String  @id @default(cuid())
  invoiceId String  @unique
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  businessFileId     String?
  businessFileSource InvoiceDropboxBusinessFileSource?

  standardizedFileName String
  originalFileName     String

  dropboxFileId      String?
  dropboxRevision    String?
  dropboxDisplayPath String?
  dropboxPathLower   String?
  dropboxContentHash String?
  dropboxSize        BigInt?

  syncStatus        DropboxDocumentSyncStatus @default(PENDING)
  lastSyncAttemptAt DateTime?
  lastSyncedAt      DateTime?
  lastErrorCode     String?
  lastErrorMessage  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([syncStatus])
  @@index([businessFileId])
}

// =============================================================================
// Phase 5A: Ledger — Manual Records only get real persistence here. System
// Records (Customer Premium Receipts, Provider/Agent Payments, Commission
// Income) are deliberately NOT duplicated into a second table: the Ledger's
// "System Records" tab is a read-only normalized projection computed
// on-the-fly from the existing PolicyCustomerReceipt / PolicyProviderPayment
// / PolicyRecord.commission* source-of-truth records — see
// src/lib/ledger/systemRecords.ts. This keeps exactly one place that can
// ever create/edit those business transactions (the Policy Financial tabs).
// =============================================================================

enum LedgerTransactionType {
  INCOME
  EXPENSE
}

// User-created only — this project deliberately never seeds/hard-codes
// business categories (e.g. "Office Expense") here; see this phase's spec.
// transactionType is fixed for the lifetime of a category once created (see
// updateLedgerCategoryAction's doc comment for why changing it is never
// offered, rather than attempting "safe validation" of existing usage).
model LedgerCategory {
  id              String                @id @default(cuid())
  name            String
  transactionType LedgerTransactionType
  isActive        Boolean               @default(true)

  // Plain unenforced id string, this project's existing convention for a
  // single user reference (see e.g. PolicyActivity.performedById).
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  manualEntries LedgerManualEntry[]

  // The same name may exist once under INCOME and once under EXPENSE (see
  // this phase's spec) — never a bare unique on name alone.
  @@unique([name, transactionType])
  @@index([transactionType])
  @@index([isActive])
}

// User-entered daily non-business income/expense — never a source for or
// derived from PolicyCustomerReceipt, PolicyProviderPayment, commission
// fields, or Invoice (see this phase's spec: "Editing must not affect
// Policy, Invoice, CustomerReceipt, ProviderPayment, or Commission").
model LedgerManualEntry {
  id              String                @id @default(cuid())
  transactionDate DateTime
  transactionType LedgerTransactionType
  categoryId      String
  category        LedgerCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  amount          Decimal @db.Decimal(16, 2)
  paymentMethod   String?
  referenceNumber String?
  description     String?

  createdById String
  createdAt   DateTime @default(now())
  updatedById String?
  updatedAt   DateTime @updatedAt

  // Same cancellation shape as Invoice (cancelledAt/cancelledById) rather
  // than PolicyCustomerReceipt/PolicyProviderPayment's bare deletedAt — a
  // Manual Record is a standalone financial record a user explicitly
  // cancels (mirroring "Cancel Invoice"), not a child row silently removed
  // as part of editing a parent, so tracking who cancelled it matters the
  // same way it does for Invoice.
  cancelledAt   DateTime?
  cancelledById String?

  @@index([transactionDate])
  @@index([transactionType])
  @@index([categoryId])
  @@index([cancelledAt])
  @@index([createdById])
}

// =============================================================================
// Phase 6A: Task — a generic participant-scoped task/timeline shared by all
// three category tabs (Daily Task, Motor Claim, Non-Motor Claim). Claim
// categories deliberately reuse the exact same Task/TaskStep shape rather
// than duplicated per-category tables — no claim-specific fields (policy
// link, claim number, amounts, ...) exist yet; those belong to a later Claim
// phase (see this phase's spec, Part K). Visibility is participant-only and
// enforced at query time everywhere (see requireTaskAccess /
// getVisibleTasksForCategory), never only hidden in the UI.
// =============================================================================

enum TaskCategory {
  DAILY_TASK
  MOTOR_CLAIM
  NON_MOTOR_CLAIM
}

enum TaskStatus {
  ACTIVE
  COMPLETED
}

model Task {
  id       String       @id @default(cuid())
  // Immutable after creation by design — no action in this phase ever
  // accepts a category change (see this phase's spec, Part B.3).
  category TaskCategory
  title    String
  status   TaskStatus   @default(ACTIVE)

  // Plain unenforced id string, this project's existing convention for a
  // single user reference (see e.g. PolicyActivity.performedById,
  // LedgerManualEntry.createdById) — the creator is always also present as
  // a TaskParticipant row (enforced in createTaskAction), so this field is
  // never used for visibility, only for authorship/authority display and
  // the "task creator" authorization checks.
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  completedAt   DateTime?
  completedById String?

  // Soft-delete/cancellation, matching Invoice/LedgerManualEntry's
  // cancelledAt+cancelledById shape (richer than the bare deletedAt used by
  // PolicyCustomerReceipt/PolicyProviderPayment) — a Task is a standalone
  // record a creator explicitly deletes, not a child row silently removed
  // as part of editing a parent.
  deletedAt   DateTime?
  deletedById String?

  participants TaskParticipant[]
  steps        TaskStep[]

  @@index([category])
  @@index([status])
  @@index([deletedAt])
  @@index([updatedAt])
  @@index([createdById])
}

// Explicit many-to-many join (not Prisma's implicit m:n) so addedAt/addedById
// audit metadata has somewhere to live — this project's existing convention
// whenever a join table needs its own fields (see e.g. InvoiceItem).
model TaskParticipant {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // Plain unenforced id string (see Task.createdById's comment) — never FK'd
  // to User, so a participant's historical steps/attribution remain intact
  // even if that User row is later edited; deactivation is handled by
  // UserStatus, not by touching this table.
  userId String

  addedAt   DateTime @default(now())
  addedById String

  // A user can appear at most once per Task — enforced at the database
  // level, not just in the create/update actions.
  @@unique([taskId, userId])
  @@index([userId])
}

// A single node in a Task's sequential action timeline. Deliberately no
// sequenceNumber column (see this phase's spec, Part C.7 — "ordering must
// remain stable and deterministic"): visible position is always computed at
// read time as the index of a step within its Task's non-deleted steps
// ordered by (createdAt asc, id asc), which trivially closes any gap left by
// a soft-deleted step without ever renumbering or touching historical
// createdAt values.
model TaskStep {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  content String

  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Set only by updateStepAction when the content is actually edited — the
  // UI's "Edited" indicator reads this field (not updatedAt) so it is never
  // triggered by anything else.
  editedAt    DateTime?

  deletedAt   DateTime?
  deletedById String?

  @@index([taskId])
  @@index([createdAt])
  @@index([deletedAt])
}

// =============================================================================
// Phase 6B: Motor Claim / Non-Motor Claim — dedicated claim-record
// management, deliberately NOT built on the generic Task/TaskStep model
// (see this phase's spec, Part B.4: "Do not render TaskWorkspace for either
// claim route after this phase"). Phase 6A created zero genuine MOTOR_CLAIM
// / NON_MOTOR_CLAIM Task rows before this phase (confirmed by inspection),
// so no legacy-data migration was required — Daily Task keeps using
// Task/TaskParticipant/TaskStep unchanged. No Policy linkage, payment,
// reserve, document, or notification fields exist yet — see this phase's
// Part K scope note; those belong to a later Claim phase.
// =============================================================================

enum ClaimStatus {
  OPEN
  CLOSED
}

enum MotorClaimNature {
  OWN_DAMAGE
  THIRD_PARTY_CLAIM
  WINDSCREEN
  ACCIDENT
}

// Fixed business order (see this phase's spec, Part C.10) — Prisma enums
// preserve declaration order, and this project's UI always iterates enum
// options in declaration order rather than re-sorting them, so the order
// here IS the order actually shown to the user.
enum MotorClaimProgress {
  PREPARE_CLAIM_DOCUMENT
  ASSESSMENT_PROCESS
  APPROVAL_AND_REPAIR
  RE_INSPECTION_AND_RELEASE
  FINISH
}

enum NonMotorClaimProgress {
  DOCUMENT_PREPARATION
  LOSS_ASSESSMENT_INVESTIGATION
  APPROVAL
  DV_ISSUED
  PAYMENT
  FINISH
}

// Same per-yearMonth atomic upsert pattern as InvoiceNumberCounter — a
// dedicated table per claim type (not a shared multi-key table) so Motor
// and Non-Motor Claim sequences are fully independent, mirroring
// InvoiceNumberCounter's own reasoning for not reusing
// PolicyRecordNumberCounter.
model MotorClaimNumberCounter {
  yearMonth    String @id
  lastSequence Int    @default(0)
}

model NonMotorClaimNumberCounter {
  yearMonth    String @id
  lastSequence Int    @default(0)
}

model MotorClaim {
  id          String @id @default(cuid())
  claimNumber String @unique

  reportedAt DateTime

  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // Optional, customer-scoped (see this phase's spec, Part B.3) — same
  // nullable-FK + onDelete: Restrict shape as PolicyRecord.projectId.
  projectId    String?
  project      CustomerProject? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  // Claim-specific snapshot, independently editable — never written back to
  // the Customer master record (see this phase's spec, Part D.14).
  contactName  String
  contactPhone String

  // No reusable insurer master list exists anywhere in this repository yet
  // (checked before implementing) — plain required text, same as
  // PolicyRecord.insurerName, not a seeded/invented list. Phase 6C adds a
  // searchable UI selector (src/lib/claims/insurers.ts) sourced from this
  // and every other insurer-bearing field, but the column itself stays
  // plain text — never a foreign key to a master table that doesn't exist.
  insurer String

  numberPlate String
  claimNature MotorClaimNature
  progress    MotorClaimProgress @default(PREPARE_CLAIM_DOCUMENT)
  status      ClaimStatus        @default(OPEN)

  // Dropbox Integration Phase 7, Part 2 — optional, explicit, user-selected
  // link to the source Policy this Claim is against. Nullable: never
  // auto-linked/guessed from customer+number plate similarity (Part 2,
  // requirement 7) — the user always makes the final selection in the
  // Claim create/edit UI. onDelete: SetNull (not Restrict/Cascade) for the
  // same reasoning as PolicyRecord.sourceQuotationId: a Claim record must
  // never be lost or blocked just because its linked Policy is later
  // deleted; it simply loses the link. Drives Claim Dropbox business-folder
  // resolution (see claimBusinessFile.ts) — reused, never duplicated,
  // through the exact same ensurePolicyDropboxBusinessFile Policy already
  // uses for its own Quotation-folder reuse.
  policyRecordId String?
  policyRecord   PolicyRecord? @relation(fields: [policyRecordId], references: [id], onDelete: SetNull)

  createdById String
  createdAt   DateTime @default(now())
  updatedById String?
  updatedAt   DateTime @updatedAt

  // Progress and status are deliberately independent fields — selecting
  // FINISH never auto-sets CLOSED, and closing never overwrites progress
  // (see this phase's spec, Part C.11).
  closedAt   DateTime?
  closedById String?

  deletedAt   DateTime?
  deletedById String?

  participants MotorClaimParticipant[]
  updates      MotorClaimUpdate[]
  documents    MotorClaimDocument[]

  // Dropbox Integration Phase 7 — only present for a Claim that has no
  // (or more than one — not applicable here, a Claim links to at most one
  // Policy) usable linked-Policy business file to reuse; see
  // MotorClaimDropboxBusinessFile's own doc comment.
  dropboxBusinessFile MotorClaimDropboxBusinessFile?

  @@index([status])
  @@index([reportedAt])
  @@index([customerId])
  @@index([projectId])
  @@index([deletedAt])
  @@index([numberPlate])
  @@index([policyRecordId])
}

model NonMotorClaim {
  id          String @id @default(cuid())
  claimNumber String @unique

  reportedAt DateTime

  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  projectId    String?
  project      CustomerProject? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  contactName  String
  contactPhone String

  insurer String

  // Reuses the existing NonMotorCoverType enum (see NonMotorPolicyDetail)
  // instead of a second, drifting type list — see this phase's spec, Part
  // F.28.
  insuranceType NonMotorCoverType
  progress      NonMotorClaimProgress @default(DOCUMENT_PREPARATION)
  status        ClaimStatus           @default(OPEN)

  // Dropbox Integration Phase 7, Part 2 — see MotorClaim.policyRecordId's
  // doc comment; identical reasoning/shape.
  policyRecordId String?
  policyRecord   PolicyRecord? @relation(fields: [policyRecordId], references: [id], onDelete: SetNull)

  createdById String
  createdAt   DateTime @default(now())
  updatedById String?
  updatedAt   DateTime @updatedAt

  closedAt   DateTime?
  closedById String?

  deletedAt   DateTime?
  deletedById String?

  participants NonMotorClaimParticipant[]
  updates      NonMotorClaimUpdate[]
  documents    NonMotorClaimDocument[]

  dropboxBusinessFile NonMotorClaimDropboxBusinessFile?

  @@index([status])
  @@index([reportedAt])
  @@index([customerId])
  @@index([projectId])
  @@index([deletedAt])
  @@index([policyRecordId])
}

// =============================================================================
// Phase 6C: Claim collaboration — participant-scoped visibility (mirrors
// TaskParticipant exactly) and a per-Claim timeline (mirrors TaskStep
// exactly), plus optional customer-scoped Project selection. Two dedicated
// participant/update model pairs (Motor/Non-Motor) rather than one shared
// polymorphic table — this schema has no polymorphic entityType+entityId
// pattern anywhere else, and a single foreign key column can only reference
// one parent table with real referential integrity, so dedicated models are
// the only way to keep a real, enforced foreign key (see this phase's spec,
// Part C.5 / Part H.25).
// =============================================================================

model MotorClaimParticipant {
  id           String     @id @default(cuid())
  motorClaimId String
  motorClaim   MotorClaim @relation(fields: [motorClaimId], references: [id], onDelete: Cascade)
  // Plain unenforced id string (see Task.createdById's comment) — never FK'd
  // to User, so a participant's historical timeline entries/attribution
  // remain intact even after their account is later deactivated.
  userId       String

  addedAt   DateTime @default(now())
  addedById String

  @@unique([motorClaimId, userId])
  @@index([userId])
}

model NonMotorClaimParticipant {
  id              String        @id @default(cuid())
  nonMotorClaimId String
  nonMotorClaim   NonMotorClaim @relation(fields: [nonMotorClaimId], references: [id], onDelete: Cascade)
  userId          String

  addedAt   DateTime @default(now())
  addedById String

  @@unique([nonMotorClaimId, userId])
  @@index([userId])
}

// A single node in a Motor Claim's chronological timeline — user-entered
// updates and system-generated entries (created, progress changed,
// closed, reopened, participants updated) share this one model, exactly
// like a Daily Task's TaskStep. No sequenceNumber column, same reasoning as
// TaskStep: visible position is always the index of a non-deleted entry
// ordered by (createdAt asc, id asc).
model MotorClaimUpdate {
  id           String     @id @default(cuid())
  motorClaimId String
  motorClaim   MotorClaim @relation(fields: [motorClaimId], references: [id], onDelete: Cascade)

  content String

  // True only for the single automatic "Claim created" entry — protected
  // from edit/delete for audit safety (see this phase's spec, Part H.30).
  // Every other system-generated entry (progress change, close, reopen,
  // participants updated) is a normal, editable/deletable entry.
  isInitial Boolean @default(false)

  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  editedAt    DateTime?

  deletedAt   DateTime?
  deletedById String?

  @@index([motorClaimId])
  @@index([createdAt])
  @@index([deletedAt])
}

model NonMotorClaimUpdate {
  id              String        @id @default(cuid())
  nonMotorClaimId String
  nonMotorClaim   NonMotorClaim @relation(fields: [nonMotorClaimId], references: [id], onDelete: Cascade)

  content String

  isInitial Boolean @default(false)

  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  editedAt    DateTime?

  deletedAt   DateTime?
  deletedById String?

  @@index([nonMotorClaimId])
  @@index([createdAt])
  @@index([deletedAt])
}

// =============================================================================
// Dropbox Integration Phase 7: Claim document storage + synchronization.
// No document/attachment model existed for either Claim type before this
// phase (confirmed by inspection) — these are genuinely new, not an
// extension of an existing document table. Two dedicated document models
// (not one polymorphic table), matching this schema's existing, explicitly
// stated convention for Motor/Non-Motor Claim child tables (see
// MotorClaimParticipant's Phase 6C doc comment: "this schema has no
// polymorphic entityType+entityId pattern anywhere else"). Mirrors
// PolicyDocument's shape, minus the issueDate/expiryDate fields (not
// meaningful for a Claim attachment) and the storageProvider/externalFileId/
// externalPath fields PolicyDocument reserved for a future Dropbox phase —
// Claim documents get a dedicated one-row-per-document sync table from day
// one instead (see MotorClaimDocumentDropboxSync), the same pattern
// InvoiceDocumentDropboxSync already uses.
// =============================================================================

enum MotorClaimDocumentType {
  CLAIM_FORM
  POLICE_ABSTRACT
  DRIVER_LICENSE
  LOGBOOK
  INSURANCE_CERTIFICATE
  ASSESSMENT_REPORT
  REPAIR_ESTIMATE
  REPAIR_INVOICE
  REINSPECTION_REPORT
  DISCHARGE_VOUCHER
  RELEASE_LETTER
  PHOTOS
  OTHER
}

enum NonMotorClaimDocumentType {
  CLAIM_FORM
  INCIDENT_REPORT
  SURVEY_REPORT
  ASSESSMENT_REPORT
  SUPPORTING_DOCUMENT
  REPAIR_ESTIMATE
  REPAIR_INVOICE
  SETTLEMENT_OFFER
  DISCHARGE_VOUCHER
  SETTLEMENT_LETTER
  PHOTOS
  OTHER
}

model MotorClaimDocument {
  id           String     @id @default(cuid())
  motorClaimId String
  motorClaim   MotorClaim @relation(fields: [motorClaimId], references: [id], onDelete: Cascade)

  documentType     MotorClaimDocumentType
  originalFileName String
  storedFileName   String
  mimeType         String
  fileSize         Int
  storagePath      String
  notes            String?

  uploadedById String
  createdAt    DateTime @default(now())

  dropboxSync MotorClaimDocumentDropboxSync?

  @@index([motorClaimId])
  @@index([documentType])
  @@index([createdAt])
}

model NonMotorClaimDocument {
  id              String        @id @default(cuid())
  nonMotorClaimId String
  nonMotorClaim   NonMotorClaim @relation(fields: [nonMotorClaimId], references: [id], onDelete: Cascade)

  documentType     NonMotorClaimDocumentType
  originalFileName String
  storedFileName   String
  mimeType         String
  fileSize         Int
  storagePath      String
  notes            String?

  uploadedById String
  createdAt    DateTime @default(now())

  dropboxSync NonMotorClaimDocumentDropboxSync?

  @@index([nonMotorClaimId])
  @@index([documentType])
  @@index([createdAt])
}

// Distinguishes which business-file table a Claim document sync row's
// businessFileId points at. ONE shared enum reused by both Motor and
// Non-Motor Claim sync tables — not a cross-domain reuse of Policy's/
// Invoice's own dedicated source enums (those stay untouched, same
// reasoning InvoiceDropboxBusinessFileSource gave for not extending
// PolicyDropboxBusinessFileSource) but a same-domain, same-concept reuse
// exactly like ClaimStatus is already shared between MotorClaim and
// NonMotorClaim above.
enum ClaimDropboxBusinessFileSource {
  QUOTATION_CASE
  POLICY_FALLBACK
  CLAIM_FALLBACK
}

// One row per Claim that has NO usable linked-Policy business file to
// reuse (policyRecordId is null, or the linked Policy's own resolution
// unexpectedly fails) — see claimBusinessFile.ts. A Claim with a linked
// Policy never gets a row here; it resolves through
// policyRecord's own business file instead (Part 3, requirement 1: never a
// second, duplicate business folder for the same insurance transaction).
// Stores an IMMUTABLE naming snapshot, same reasoning/shape as every other
// *DropboxBusinessFile model in this schema.
model MotorClaimDropboxBusinessFile {
  id           String     @id @default(cuid())
  motorClaimId String     @unique
  motorClaim   MotorClaim @relation(fields: [motorClaimId], references: [id], onDelete: Cascade)

  businessDate       DateTime
  insuranceTypeCode  String
  customerShortName  String
  businessTitle      String
  businessFolderName String

  dropboxFolderId    String?
  dropboxDisplayPath String?
  dropboxPathLower   String?

  syncStatus        DropboxBusinessFileSyncStatus @default(PENDING)
  lastSyncAttemptAt DateTime?
  lastSyncedAt      DateTime?
  lastErrorCode     String?
  lastErrorMessage  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([syncStatus])
}

model NonMotorClaimDropboxBusinessFile {
  id              String        @id @default(cuid())
  nonMotorClaimId String        @unique
  nonMotorClaim   NonMotorClaim @relation(fields: [nonMotorClaimId], references: [id], onDelete: Cascade)

  businessDate       DateTime
  insuranceTypeCode  String
  customerShortName  String
  businessTitle      String
  businessFolderName String

  dropboxFolderId    String?
  dropboxDisplayPath String?
  dropboxPathLower   String?

  syncStatus        DropboxBusinessFileSyncStatus @default(PENDING)
  lastSyncAttemptAt DateTime?
  lastSyncedAt      DateTime?
  lastErrorCode     String?
  lastErrorMessage  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([syncStatus])
}

// One row per Claim document's sync state — mirrors
// PolicyDocumentDropboxSync/InvoiceDocumentDropboxSync exactly.
// claimFolderName is an additional immutable snapshot beyond what Policy/
// Invoice need: unlike a Policy document (filed directly in one shared
// "Policy" subfolder) or an Invoice file (one per Invoice), multiple
// Claims can exist under the same business folder, so each Claim gets its
// own reference subfolder under "Claim/" — this snapshot records that
// subfolder's name so retries never need to re-derive it (Part 4).
model MotorClaimDocumentDropboxSync {
  id                   String             @id @default(cuid())
  motorClaimDocumentId String             @unique
  motorClaimDocument   MotorClaimDocument @relation(fields: [motorClaimDocumentId], references: [id], onDelete: Cascade)

  businessFileId     String?
  businessFileSource ClaimDropboxBusinessFileSource?
  claimFolderName    String?

  standardizedFileName String
  originalFileName     String

  dropboxFileId      String?
  dropboxRevision    String?
  dropboxDisplayPath String?
  dropboxPathLower   String?
  dropboxContentHash String?
  dropboxSize        BigInt?

  syncStatus        DropboxDocumentSyncStatus @default(PENDING)
  lastSyncAttemptAt DateTime?
  lastSyncedAt      DateTime?
  lastErrorCode     String?
  lastErrorMessage  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([syncStatus])
  @@index([businessFileId])
}

model NonMotorClaimDocumentDropboxSync {
  id                      String                @id @default(cuid())
  nonMotorClaimDocumentId String                @unique
  nonMotorClaimDocument   NonMotorClaimDocument @relation(fields: [nonMotorClaimDocumentId], references: [id], onDelete: Cascade)

  businessFileId     String?
  businessFileSource ClaimDropboxBusinessFileSource?
  claimFolderName    String?

  standardizedFileName String
  originalFileName     String

  dropboxFileId      String?
  dropboxRevision    String?
  dropboxDisplayPath String?
  dropboxPathLower   String?
  dropboxContentHash String?
  dropboxSize        BigInt?

  syncStatus        DropboxDocumentSyncStatus @default(PENDING)
  lastSyncAttemptAt DateTime?
  lastSyncedAt      DateTime?
  lastErrorCode     String?
  lastErrorMessage  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([syncStatus])
  @@index([businessFileId])
}

// ============================================================
// Dropbox Root Migration (Home namespace -> ENFB SYSTEM FILE Team
// Folder namespace). Additive-only; see backups/ for the pg_dump taken
// immediately before this migration was applied.
//
// Namespaces are NOT interchangeable path prefixes — a Team Folder is its
// own distinct Dropbox namespace (confirmed via a live read-only diagnostic:
// the Team Folder's own namespace id was resolved from its
// sharing_info/shared_folder_id, and files/list_folder("") against that
// namespace id directly returns its own root, with no
// "ENFB SYSTEM FILE Team Folder" path prefix needed). So every existing
// Dropbox-backed model's stored path/id fields are namespace-scoped, and
// this section exists to migrate between namespaces without ever
// reinterpreting an old id/path in the new namespace.
// ============================================================

enum DropboxNamespaceMode {
  HOME
  TEAM_FOLDER_NAMESPACE
}

enum DropboxMigrationStatus {
  NOT_STARTED
  DIAGNOSTIC_COMPLETE
  WRITE_TEST_REQUIRED
  WRITE_TEST_PASSED
  PREVIEW_READY
  READY_FOR_COPY
  COPYING
  COPY_PAUSED
  COPY_FAILED
  COPY_COMPLETE
  VERIFYING
  VERIFICATION_FAILED
  VERIFIED
  READY_TO_ACTIVATE
  ACTIVATING
  ACTIVE
  COMPLETED
}

enum DropboxMigrationPreviewResult {
  SAFE_TO_CONTINUE
  BLOCKED_BY_CONFLICT
  BLOCKED_BY_PERMISSION
  BLOCKED_BY_STRUCTURE
  MANUAL_REVIEW_REQUIRED
}

enum DropboxMigrationObjectKind {
  ROOT
  CUSTOMER_FOLDER
  CUSTOMER_STANDARD_SUBFOLDER
  CUSTOMER_DOCUMENT
  QUOTATION_BUSINESS_FOLDER
  QUOTATION_VERSION_FILE
  POLICY_BUSINESS_FOLDER
  POLICY_DOCUMENT
  INVOICE_BUSINESS_FOLDER
  INVOICE_DOCUMENT
  MOTOR_CLAIM_BUSINESS_FOLDER
  MOTOR_CLAIM_DOCUMENT
  NON_MOTOR_CLAIM_BUSINESS_FOLDER
  NON_MOTOR_CLAIM_DOCUMENT
  UNCLASSIFIED
}

enum DropboxMigrationObjectType {
  FILE
  FOLDER
}

enum DropboxMigrationObjectStatus {
  DISCOVERED
  PENDING
  COPYING
  COPIED
  VERIFYING
  VERIFIED
  SKIPPED_IDENTICAL
  CONFLICT
  MISSING_SOURCE
  FAILED
}

// Singleton (fixed id, same convention as DropboxIntegration/SystemSettings
// above) — the ONE place "which namespace is active right now" is recorded.
// src/lib/integrations/dropbox/service.ts's getAuthenticatedDropboxClient()
// reads this row to decide whether to build a Home-namespace client (the
// unchanged, pre-migration behavior) or a destination-namespace client, and
// to substitute the effective root folder accordingly — every existing sync
// module reads root folder only through that one function's return value,
// so this is the single choke point the whole app's Dropbox writes route
// through post-activation.
model DropboxNamespaceConfig {
  id String @id

  activeNamespaceMode DropboxNamespaceMode @default(HOME)
  activeRootFolder    String               @default("/Insurance Management System")

  // AES-256-GCM, same encryption scheme/key as
  // DropboxIntegration.encryptedRefreshToken (see encryption.ts) — the
  // destination namespace id is not a credential, but it is namespace
  // identity data this project's own migration spec requires be kept out of
  // logs/UI/tests, so it gets the same at-rest protection as the refresh
  // token rather than being stored as plaintext.
  encryptedDestinationNamespaceId String?
  // Safe, human-readable label only — e.g. "Team Folder — ENFB SYSTEM FILE
  // Team Folder" — never the raw id. Shown directly in Settings.
  destinationNamespaceDisplayName String?
  destinationRootFolder           String    @default("/Insurance Management System")
  destinationResolvedAt           DateTime?

  // While true, getAuthenticatedDropboxClient() refuses every normal sync
  // call with MIGRATION_LOCKED (safe, transient) rather than ERROR — every
  // existing sync module already retries ERROR-status rows via its
  // preview/backfill "retry-failed" action, so lifting the lock and
  // re-running those existing actions is exactly the "replay pending sync"
  // step (Part 7/Part 10) with no new replay-queue machinery required.
  migrationLocked   Boolean   @default(false)
  migrationLockedAt DateTime?

  lastErrorCode    String?
  lastErrorMessage String?

  activatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per migration attempt (a fresh diagnostic/preview/copy cycle
// creates a new row rather than reusing an old one, so history of prior
// attempts — including abandoned ones — is preserved for audit).
model DropboxMigrationJob {
  id String @id @default(cuid())

  status       DropboxMigrationStatus @default(NOT_STARTED)
  currentPhase String?

  sourceNamespaceMode      DropboxNamespaceMode @default(HOME)
  destinationNamespaceMode DropboxNamespaceMode @default(TEAM_FOLDER_NAMESPACE)

  sourceRootPath      String
  destinationRootPath String

  sourceRootFolderId      String?
  destinationRootFolderId String?

  // Flat typed counters rather than a JSON blob — this schema's existing
  // convention (see PolicyActivity's comment above) is no model anywhere
  // uses a Json column.
  previewResult                      DropboxMigrationPreviewResult?
  previewSummary                     String?
  previewTotalFolders                Int?
  previewTotalFiles                  Int?
  previewTotalBytes                  BigInt?
  previewCustomerFolders             Int?
  previewCustomerDocuments           Int?
  previewQuotationFolders            Int?
  previewQuotationFiles              Int?
  previewPolicyFolders               Int?
  previewPolicyFiles                 Int?
  previewInvoiceFolders              Int?
  previewInvoiceFiles                Int?
  previewMotorClaimFolders           Int?
  previewMotorClaimFiles             Int?
  previewNonMotorClaimFolders        Int?
  previewNonMotorClaimFiles          Int?
  previewUnexpectedObjects           Int?
  previewIdenticalDestinationObjects Int?
  previewConflictObjects             Int?
  previewedAt                        DateTime?

  safeErrorCode    String?
  safeErrorMessage String?

  // Plain unenforced id string — same convention as
  // DropboxIntegration.connectedById above.
  initiatedById String?

  startedAt   DateTime?
  copiedAt    DateTime?
  verifiedAt  DateTime?
  activatedAt DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  objects DropboxMigrationObjectLedger[]

  @@index([status])
}

// Per-object copy/verify ledger — one row per Dropbox folder or file the
// migration touches. Deliberately keyed on (migrationJobId, sourcePath),
// not on source Dropbox id alone: a source id is only known once the object
// has actually been discovered/looked up, whereas the deterministic path is
// known up front from the owning DB record, and must stay stable across
// resumed runs for idempotency.
model DropboxMigrationObjectLedger {
  id String @id @default(cuid())

  migrationJobId String
  migrationJob   DropboxMigrationJob @relation(fields: [migrationJobId], references: [id])

  objectKind DropboxMigrationObjectKind
  objectType DropboxMigrationObjectType

  sourcePath     String
  sourceId       String?
  sourceRevision String?

  destinationPath String
  destinationId   String?

  expectedContentHash String?
  expectedFileSize    BigInt?

  status       DropboxMigrationObjectStatus @default(DISCOVERED)
  attemptCount Int                          @default(0)

  copiedAt   DateTime?
  verifiedAt DateTime?

  safeErrorCode    String?
  safeErrorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([migrationJobId, sourcePath])
  @@index([migrationJobId, status])
}

// =============================================================================
// Production Initialization (Settings > System, ADMIN-only) — a one-way,
// triple-confirmed action that clears all business data (Customer through
// Claims, Ledger, Task, historical import batches, and the five business
// number counters) while leaving User/SystemSettings/DropboxIntegration/
// DropboxNamespaceConfig/InsuranceType/LedgerCategory/the Dropbox migration
// history untouched, and never deletes any real Dropbox file. See
// src/lib/productionInit/execute.ts's doc comment for the full deletion
// order and the reasoning behind it (derived from this schema's actual
// onDelete: Restrict/Cascade/SetNull relations, not assumed).
// =============================================================================

enum SystemInitializationStatus {
  RUNNING
  SUCCESS
  FAILED
}

// Audit trail for the action described above. This table, and every row in
// it, is itself explicitly EXCLUDED from what Production Initialization
// deletes — see runProductionInitialization's doc comment — so "did this
// system ever get wiped, by whom, when, with what result" always survives
// the wipe it describes, including failed attempts.
//
// deletedCounts/preservedCountsBefore/preservedCountsAfter are the one
// deliberate exception to this schema's established "flat, typed columns,
// never Json" convention (see PolicyActivity.summary's doc comment for that
// general rule) — this is a flexible, append-only diagnostic snapshot read
// only by this feature's own admin UI, never joined/filtered/aggregated
// against, so a fixed set of typed columns would only add migration churn
// every time a deletable/preserved model is added or renamed, with no real
// benefit over a plain count-by-name map.
model SystemInitializationLog {
  id String @id @default(cuid())

  // Plain unenforced id string (this schema's existing convention for a
  // single user reference, see e.g. PolicyActivity.performedById) plus a
  // point-in-time name snapshot, so this row stays fully meaningful even if
  // the acting admin's account is later renamed or disabled.
  executedByUserId       String
  executedByNameSnapshot String

  status      SystemInitializationStatus @default(RUNNING)
  startedAt   DateTime                   @default(now())
  completedAt DateTime?

  // Admin-selected reason, validated server-side against a fixed whitelist
  // (see src/lib/productionInit/constants.ts's PRODUCTION_INIT_REASONS —
  // never an arbitrary client-supplied string). Nullable only because rows
  // created before this field existed have none; every row created going
  // forward always has one (required at the API layer, not just here).
  // Never read by the deletion/rollback logic itself — purely descriptive.
  reason String?

  deletedCounts         Json?
  preservedCountsBefore Json?
  preservedCountsAfter  Json?

  // Safe, short, human-readable summary only — NEVER a raw stack trace,
  // database error, or any Dropbox/credential value. Full technical detail
  // goes to server (process) logs only, never this table.
  errorSummary String?

  appVersion String?
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startedAt])
}
