// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Locale {
  en
  zh
}

model User {
  id                String     @id @default(cuid())
  username          String     @unique
  fullName          String
  passwordHash      String
  role              String     @default("Staff")
  phoneNumber       String?
  permissions       String[]   @default([])
  status            UserStatus @default(ACTIVE)
  preferredLanguage Locale     @default(en)
  createdAt         DateTime   @default(now())
  lastLoginAt       DateTime?
  updatedAt         DateTime   @updatedAt
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  SUSPENDED
}

enum CustomerDocumentType {
  REGISTRATION_CERTIFICATE
  PIN_CERTIFICATE
  CR12
  OTHER
}

// Phase 1A.1: distinguishes a normally-onboarded Customer from one created
// directly out of the Motor historical-import preview (see
// createCustomersFromHistoricalNamesAction) — mirrors PolicyRecordSource's
// MANUAL/HISTORICAL_IMPORT split.
enum CustomerSource {
  MANUAL
  HISTORICAL_IMPORT
}

model Customer {
  id                String         @id @default(cuid())
  sequenceNumber    Int            @unique @default(autoincrement())
  customerNumber    String         @unique
  companyName       String         @unique
  // Required + unique at the DB level (predates Phase 1A.1) — a historical
  // import must never invent a plausible-looking real PIN to satisfy this,
  // so createCustomersFromHistoricalNamesAction writes a clearly-fake
  // "PENDING-<customerNumber>" sentinel instead (never mistakable for a real
  // KRA PIN) and sets isIncomplete below. Real PIN capture stays a normal
  // Customer-module edit once the business has the real number.
  pinNumber         String         @unique
  registeredAddress String?
  mainContactPerson String?
  mainPhoneNumber   String?
  status            CustomerStatus @default(ACTIVE)

  // Storage abstraction (reserved for future Dropbox sync)
  storageFolderId     String?
  storageFolderPath   String?
  storageSyncStatus   String?   @default("pending")
  storageLastSyncedAt DateTime?

  // Phase 1A.1: historical-import provenance. All nullable/defaulted so
  // every pre-existing and every normally-created Customer is unaffected
  // (source=MANUAL, isIncomplete=false, nothing else set). Only
  // createCustomersFromHistoricalNamesAction ever writes these.
  source            CustomerSource     @default(MANUAL)
  // True whenever this record is missing real PIN/contact/phone/address —
  // i.e. every historical-import-created Customer, until someone edits it
  // with real data. Checked independently of `source` so a manually
  // completed historical customer can clear this flag via a normal edit.
  isIncomplete      Boolean            @default(false)
  importBatchId     String?
  importBatch       PolicyImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  sourceSheet       String?
  originalRowNumber Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects       CustomerProject[]
  documents      CustomerDocument[]
  quotations     Quotation[]
  quotationCases QuotationCase[]
  policyRecords  PolicyRecord[]
  invoices       Invoice[]

  @@index([companyName])
  @@index([status])
  @@index([importBatchId])
}

model CustomerProject {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  projectName   String
  contactPerson String
  phoneNumber   String
  description   String?
  status        ProjectStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents      CustomerDocument[]
  quotations     Quotation[]
  quotationCases QuotationCase[]
  policyRecords  PolicyRecord[]

  @@index([customerId])
}

model CustomerDocument {
  id         String           @id @default(cuid())
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  projectId  String?
  project    CustomerProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  documentType       CustomerDocumentType
  customDocumentName String?
  originalFileName   String
  storedFileName     String
  mimeType           String
  fileSize           Int

  // Storage abstraction (reserved for future Dropbox sync)
  storageProvider String  @default("local")
  storageKey      String
  dropboxFileId   String?
  dropboxPath     String?
  syncStatus      String  @default("pending")
  syncError       String?

  uploadedBy String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
  @@index([projectId])
}

enum QuotationStatus {
  DRAFT
  ISSUED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

// --- Phase 1 quotation revision history -----------------------------------
// Status of one specific Quotation row now that Quotation is a revision
// record under a QuotationCase (see that model's doc comment). Independent
// of the pre-existing QuotationStatus above, which is left untouched for
// backward compatibility — nothing reads RevisionStatus except the new
// revision-aware code paths added in this phase.
enum RevisionStatus {
  DRAFT
  ISSUED
  SUPERSEDED
  ACCEPTED
  CANCELLED
}

// Status of the permanent quotation case (the enquiry as a whole), tracked
// independently of any one revision's RevisionStatus.
//
// Phase 2B case lifecycle (display labels, not new enum values):
//   DRAFT       -> "Preparing Documents" (case created, no revision yet)
//   IN_PROGRESS -> "Quotation In Progress" (R01 exists, still DRAFT)
//   QUOTED / ACCEPTED / DECLINED / CONVERTED_TO_POLICY -> unchanged
// IN_PROGRESS existed in this enum since Phase 1 but was never actually set
// by any code path — Phase 2B is the first thing that sets it, when
// startFirstQuotationAction creates R01.
enum QuotationCaseStatus {
  DRAFT
  IN_PROGRESS
  QUOTED
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED_TO_POLICY
}

// Phase 2: underwriting document categories. Practical categories an
// underwriter actually asks for, not a generic "attachment" bucket — OTHER
// is the deliberate escape hatch (paired with QuotationDocument.customTypeName).
enum QuotationDocumentType {
  AWARD_LETTER
  TENDER_DOCUMENT
  BOQ
  CONTRACT_DOCUMENT
  EMPLOYEE_SCHEDULE
  VEHICLE_SCHEDULE
  EQUIPMENT_SCHEDULE
  ASSET_SCHEDULE
  STOCK_SCHEDULE
  GOODS_SCHEDULE
  MEDICAL_CENSUS
  CLAIMS_HISTORY
  PREVIOUS_POLICY
  INSURER_QUOTATION
  PIN_CERTIFICATE
  REGISTRATION_CERTIFICATE
  CR12
  ID_DOCUMENT
  APPLICATION_FORM
  FINANCIAL_STATEMENTS
  OTHER
}

// Every Phase 2 document uses LOCAL. DROPBOX is reserved for Phase 3 and
// must not be selectable or written by any code path yet.
enum DocumentStorageProvider {
  LOCAL
  DROPBOX
}

// Every Phase 2 (LOCAL) document uses NOT_APPLICABLE — sync only has
// meaning once a Dropbox provider exists in Phase 3.
enum DocumentSyncStatus {
  NOT_APPLICABLE
  PENDING
  SYNCED
  FAILED
}

enum CalculationMethod {
  PERCENTAGE
  FIXED_PREMIUM
  MANUAL_PREMIUM
}

// Discriminates which structured detail table (if any) a section carries.
// GENERIC sections (the original line-item model) have no detail row and
// keep working exactly as before — this field defaults to GENERIC so every
// pre-Phase-1 section is unaffected. Adding a future insurance type only
// means adding one more enum value plus one more *SectionDetail model; it
// never requires touching the sections/kinds that already exist.
enum QuotationSectionKind {
  GENERIC
  CAR_PACKAGE
  WIBA
  EMPLOYERS_LIABILITY
  CPM_STANDALONE
  PUBLIC_LIABILITY
  FIRE_AND_PERILS
  BURGLARY
  GIT_SINGLE
  GIT_ANNUAL
  MARINE_COVER
  MOTOR_COMP_PRIVATE
  MOTOR_COMP_COMMERCIAL
  MOTOR_TPO_PRIVATE
  MOTOR_TPO_COMMERCIAL
  GROUP_PERSONAL_ACCIDENT
  GROUP_MEDICAL
  TENDER_SECURITY
  PERFORMANCE_BOND
  ADVANCE_PAYMENT_GUARANTEE
  CUSTOMS_BOND
}

// Fixed family categories for Group Medical — an enum (rather than free
// text) so Phase 2B cannot introduce arbitrary category labels. "+" isn't a
// valid Prisma enum identifier, so the DB label is set via @map.
enum MedicalFamilyCategory {
  M
  M_PLUS_1 @map("M+1")
  M_PLUS_2 @map("M+2")
  M_PLUS_3 @map("M+3")
  M_PLUS_4 @map("M+4")
  M_PLUS_5 @map("M+5")
}

// Master configuration for insurance types offered on quotations. Editing a
// row here only affects future sections — existing QuotationInsuranceSection
// rows keep their own snapshot of rates/clauses at the time they were added.
model InsuranceType {
  id          String  @id @default(cuid())
  name        String
  code        String  @unique
  description String?

  defaultPHCFRate  Decimal @default(0.25) @db.Decimal(10, 4)
  defaultITLRate   Decimal @default(0.20) @db.Decimal(10, 4)
  defaultStampDuty Decimal @default(40) @db.Decimal(12, 2)
  applyPHCF        Boolean @default(true)
  applyITL         Boolean @default(true)
  applyStampDuty   Boolean @default(true)

  defaultClauses    String?
  defaultExclusions String?
  defaultConditions String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections QuotationInsuranceSection[]

  @@index([active])
}

// Atomic per-month counter backing the QT{YYYYMM}-{seq} quotation number
// format. A single row per year-month, incremented via an INSERT ... ON
// CONFLICT DO UPDATE so concurrent quotation creation can never collide.
model QuotationNumberCounter {
  yearMonth    String @id
  lastSequence Int    @default(0)
}

// The permanent quotation enquiry — owns every historical revision. Created
// once, its quotationNumber (the original QT{YYYYMM}-{seq}) never changes
// and is never regenerated for a revision. currentRevisionId/
// acceptedRevisionId are plain pointer columns (not Prisma @relation fields)
// deliberately: they point at a Quotation row that already belongs to this
// same case via Quotation.quotationCaseId, and adding a second, named
// relation in the other direction would create a circular FK pair for no
// real benefit here — this project's existing convention already stores
// single user references (Quotation.createdBy) as plain, unenforced id
// strings rather than relations, and this follows the same pattern.
// Consistency ("does currentRevisionId actually belong to this case, and is
// isCurrentRevision actually true on exactly that row") is guaranteed by
// always updating both together inside the same transaction — see
// src/lib/quotationRevisions/*.
model QuotationCase {
  id              String           @id @default(cuid())
  quotationNumber String           @unique
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  projectId       String?
  project         CustomerProject? @relation(fields: [projectId], references: [id], onDelete: Restrict)

  // Phase 2B: case-level fields that exist before any revision does — an
  // enquiry can sit in "Preparing Documents" for a while with no Quotation
  // row at all. internalNote replaces the old, always-unused `title` field
  // (never read anywhere in the app) rather than adding a second, redundant
  // free-text column.
  internalNote             String?
  enquiryDate              DateTime?
  intendedInsuranceTypeIds String[]            @default([])
  status                   QuotationCaseStatus @default(DRAFT)

  currentRevisionId  String? @unique
  acceptedRevisionId String? @unique

  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  revisions  Quotation[]
  documents  QuotationDocument[]
  activities QuotationCaseActivity[]

  @@index([customerId])
  @@index([projectId])
  @@index([status])
  @@index([updatedAt])
}

// Phase 2A: minimal, quotation-side counterpart to PolicyActivity — records
// events that happen to the case as a *result* of the Quotation -> Policy
// relationship (currently just POLICY_CREATED). Deliberately much smaller
// than PolicyActivity's action-type list: this is not a general quotation
// audit log, only the one cross-module event this phase introduces. Follows
// the same append-only, no-edit/delete convention as PolicyActivity.
enum QuotationCaseActivityActionType {
  POLICY_CREATED
}

model QuotationCaseActivity {
  id              String        @id @default(cuid())
  quotationCaseId String
  quotationCase   QuotationCase @relation(fields: [quotationCaseId], references: [id], onDelete: Cascade)

  actionType QuotationCaseActivityActionType
  summary    String
  details    String?

  performedById String?
  createdAt     DateTime @default(now())

  @@index([quotationCaseId])
  @@index([createdAt])
}

// Phase 2: one shared underwriting-document library per QuotationCase —
// deliberately NOT linked to an individual Quotation (revision) row, since
// supporting documents (award letters, schedules, previous policies, ...)
// stay relevant across every revision of the same case. Soft-deleted
// (deletedAt/deletedById) rather than hard-deleted so the physical file and
// audit trail survive a mistaken delete; see deleteDocumentAction's doc
// comment for the recovery procedure. storageProvider/dropboxPath/
// dropboxFileId/syncStatus/syncError are reserved for Phase 3 — every
// Phase 2 row is storageProvider=LOCAL, syncStatus=NOT_APPLICABLE, and
// nothing in this phase reads or writes the Dropbox fields.
model QuotationDocument {
  id              String        @id @default(cuid())
  quotationCaseId String
  quotationCase   QuotationCase @relation(fields: [quotationCaseId], references: [id], onDelete: Cascade)

  documentType   QuotationDocumentType
  customTypeName String?

  originalFileName String
  storedFileName   String
  mimeType         String
  fileExtension    String?
  fileSize         Int

  description  String?
  documentDate DateTime?

  storageProvider DocumentStorageProvider @default(LOCAL)
  storagePath     String
  checksum        String?

  dropboxPath   String?
  dropboxFileId String?
  syncStatus    DocumentSyncStatus @default(NOT_APPLICABLE)
  syncError     String?

  uploadedById String
  uploadedAt   DateTime  @default(now())
  updatedById  String?
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedById  String?

  @@index([quotationCaseId])
  @@index([documentType])
  @@index([uploadedAt])
  @@index([deletedAt])
  @@index([syncStatus])
}

model Quotation {
  id              String           @id @default(cuid())
  // No longer globally unique as of Phase 1: every revision under the same
  // QuotationCase intentionally shares its case's quotationNumber (R01,
  // R02, R03... all display as QT202607-081-R0n). Uniqueness of the
  // permanent case number now lives on QuotationCase.quotationNumber
  // instead; per-case revision uniqueness is enforced by the
  // (quotationCaseId, revisionNumber) unique constraint below. Indexed
  // (not unique) since it is still a common lookup/display key.
  quotationNumber String
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  projectId       String?
  project         CustomerProject? @relation(fields: [projectId], references: [id], onDelete: Restrict)

  quotationDate DateTime        @default(now())
  validUntil    DateTime?
  currency      String          @default("KES")
  status        QuotationStatus @default(DRAFT)
  internalNotes String?

  subtotalPremium Decimal @default(0) @db.Decimal(16, 2)
  totalPHCF       Decimal @default(0) @db.Decimal(16, 2)
  totalITL        Decimal @default(0) @db.Decimal(16, 2)
  totalStampDuty  Decimal @default(0) @db.Decimal(16, 2)
  grandTotal      Decimal @default(0) @db.Decimal(16, 2)

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections QuotationInsuranceSection[]

  // --- Phase 1 revision fields ---------------------------------------
  // All nullable: this is an additive migration on a table with existing
  // rows, and the one-time backfill (see prisma/migrations/.../backfill)
  // populates these for every pre-existing row rather than a schema-level
  // default. New code must always set them; nothing currently reads them
  // as required. See RevisionStatus's doc comment for why this is a
  // separate field from the pre-existing `status` above.
  quotationCaseId   String?
  quotationCase     QuotationCase?  @relation(fields: [quotationCaseId], references: [id], onDelete: Cascade)
  revisionNumber    Int?
  // Denormalized "R01"/"R02".../"R99" display form of revisionNumber,
  // stored (not computed on read) so every historical Excel filename and
  // UI reference stays stable even if the padding convention ever changes.
  revisionCode      String?
  revisionStatus    RevisionStatus?
  revisionReason    String?
  isCurrentRevision Boolean         @default(false)

  issuedAt           DateTime?
  issuedById         String?
  supersededAt       DateTime?
  acceptedAt         DateTime?
  acceptedById       String?
  cancelledAt        DateTime?
  cancelledById      String?
  // Required by cancelRevisionAction's validation, not enforced at the DB
  // level (nullable) so any pre-Phase-1 row is never in violation.
  cancellationReason String?

  // --- Phase 2A: Quotation -> PolicyRecord relationship ------------------
  // One revision may become the source of zero, one, or many policies (see
  // PolicyRecord.sourceQuotationId's doc comment) — never the other way
  // round, and never one-to-one: a single revision can carry several Motor
  // sections (multiple vehicles) or, in the future, several different
  // insurance-type sections, each producing its own PolicyRecord.
  policyRecords PolicyRecord[]

  @@unique([quotationCaseId, revisionNumber])
  @@index([quotationNumber])
  @@index([customerId])
  @@index([projectId])
  @@index([status])
  @@index([quotationCaseId])
  @@index([isCurrentRevision])
  @@index([revisionStatus])
}

model QuotationInsuranceSection {
  id              String        @id @default(cuid())
  quotationId     String
  quotation       Quotation     @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  insuranceTypeId String
  insuranceType   InsuranceType @relation(fields: [insuranceTypeId], references: [id], onDelete: Restrict)

  // Which structured *SectionDetail table (if any) this section carries.
  // Defaults to GENERIC so every section created before Phase 1 keeps its
  // original meaning untouched.
  sectionKind QuotationSectionKind @default(GENERIC)

  // Snapshots — set when the section is added and edited independently of
  // the InsuranceType master record from then on.
  insuranceTypeNameSnapshot String
  description               String?
  phcfRate                  Decimal @db.Decimal(10, 4)
  itlRate                   Decimal @db.Decimal(10, 4)
  stampDuty                 Decimal @db.Decimal(12, 2)
  applyPHCF                 Boolean
  applyITL                  Boolean
  applyStampDuty            Boolean
  clausesSnapshot           String?
  exclusionsSnapshot        String?
  conditionsSnapshot        String?

  // Roll-up totals — always populated here regardless of sectionKind, using
  // the same shape the Excel export and quotation summary already read.
  // Structured sections compute these from their own detail row; GENERIC
  // sections compute them from the sum of their coverage items, as before.
  basePremium  Decimal @default(0) @db.Decimal(16, 2)
  phcfAmount   Decimal @default(0) @db.Decimal(16, 2)
  itlAmount    Decimal @default(0) @db.Decimal(16, 2)
  sectionTotal Decimal @default(0) @db.Decimal(16, 2)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Generic line items. Still populated (as a human-readable, non-authoritative
  // breakdown) for structured sections too, so the existing Excel export needs
  // no changes to display a meaningful item table for any sectionKind.
  items QuotationCoverageItem[]

  carDetail  CarSectionDetail?
  wibaDetail WibaSectionDetail?
  elDetail   ElSectionDetail?
  cpmDetail  CpmSectionDetail?

  // --- Phase 2A structured insurance-type detail relations -------------
  publicLiabilityDetail PublicLiabilitySectionDetail?
  fireDetail            FireSectionDetail?
  burglaryDetail        BurglarySectionDetail?
  gitSingleDetail       GitSingleSectionDetail?
  gitAnnualDetail       GitAnnualSectionDetail?
  marineDetail          MarineSectionDetail?

  // --- Phase 2B structured insurance-type detail relations -------------
  motorCompPrivateDetail        MotorCompPrivateSectionDetail?
  motorCompCommercialDetail     MotorCompCommercialSectionDetail?
  motorTpoPrivateDetail         MotorTpoPrivateSectionDetail?
  motorTpoCommercialDetail      MotorTpoCommercialSectionDetail?
  gpaDetail                     GpaSectionDetail?
  medicalDetail                 MedicalSectionDetail?
  tenderSecurityDetail          TenderSecuritySectionDetail?
  performanceBondDetail         PerformanceBondSectionDetail?
  advancePaymentGuaranteeDetail AdvancePaymentGuaranteeSectionDetail?
  customsBondDetail             CustomsBondSectionDetail?

  @@index([quotationId])
  @@index([insuranceTypeId])
}

// --- Phase 1 structured insurance-type detail tables --------------------
// Each insurance type gets its own SectionDetail model, holding the
// type-specific inputs and the computed sub-premium breakdown for that type.
// A future insurance type (Fire, Marine, GPA, ...) is added the same way:
// one new *SectionDetail model + one new QuotationSectionKind value, with no
// changes required to the models below.

model CarSectionDetail {
  id        String                    @id @default(cuid())
  sectionId String                    @unique
  section   QuotationInsuranceSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  // Common CAR details
  projectName   String?
  contractValue Decimal @db.Decimal(18, 2)
  carRate       Decimal @db.Decimal(10, 4)

  // Legacy contract date range — superseded by the month fields below for
  // Phase 1 CAR quotations. Left nullable (rather than dropped) so rows
  // written before this change keep their original dates untouched; any
  // quotation that gets edited and re-saved after this change switches over
  // to the month fields and these become null going forward.
  contractPeriodFrom DateTime?
  contractPeriodTo   DateTime?

  // Construction / maintenance period, in whole months. Required for every
  // CAR section created or re-saved from this point on.
  constructionPeriodMonths Int?
  maintenancePeriodMonths  Int?

  // CPM inside CAR (optional — both blank means no CPM component)
  cpmValue Decimal? @db.Decimal(18, 2)
  cpmRate  Decimal? @db.Decimal(10, 4)

  // TPL inside CAR
  tplAnyOneClaim   Decimal? @db.Decimal(18, 2)
  tplAnyOneEvent   Decimal? @db.Decimal(18, 2)
  tplAnyOnePeriod  Decimal? @db.Decimal(18, 2)
  tplRate          Decimal? @db.Decimal(10, 4)
  tplComplimentary Boolean  @default(false)

  // Optional PVT loading — standardized "Amount x Rate = Premium" model
  // (0.15 meaning 0.15%, same convention as every other rate here).
  // pvtLoadingAmount is the calculation base, pvtLoadingRate is the
  // percentage, pvtLoadingPremium is the snapshotted result — only the
  // premium is ever added into gross premium. Quotations saved before this
  // model existed stored pvtLoadingAmount as a manually-entered premium
  // under the previous logic; those rows are never silently reinterpreted
  // (see pvtLoading.ts / the Phase 3A-era migration backfill note).
  pvtLoadingEnabled Boolean  @default(false)
  pvtLoadingRate    Decimal? @db.Decimal(10, 4)
  pvtLoadingAmount  Decimal  @default(0) @db.Decimal(16, 2)
  pvtLoadingPremium Decimal  @default(0) @db.Decimal(16, 2)

  // Computed breakdown (snapshotted at save time)
  carBasicPremium     Decimal @default(0) @db.Decimal(16, 2)
  carCpmPremium       Decimal @default(0) @db.Decimal(16, 2)
  carMainGrossPremium Decimal @default(0) @db.Decimal(16, 2)
  carMainPhcf         Decimal @default(0) @db.Decimal(16, 2)
  carMainItl          Decimal @default(0) @db.Decimal(16, 2)
  carMainStampDuty    Decimal @default(0) @db.Decimal(16, 2)
  carMainTotal        Decimal @default(0) @db.Decimal(16, 2)

  tplGrossPremium Decimal @default(0) @db.Decimal(16, 2)
  tplPhcf         Decimal @default(0) @db.Decimal(16, 2)
  tplItl          Decimal @default(0) @db.Decimal(16, 2)
  tplStampDuty    Decimal @default(0) @db.Decimal(16, 2)
  tplTotalPremium Decimal @default(0) @db.Decimal(16, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WibaSectionDetail {
  id        String                    @id @default(cuid())
  sectionId String                    @unique
  section   QuotationInsuranceSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  wibaRate Decimal @db.Decimal(10, 4)

  // Computed breakdown (snapshotted at save time)
  totalEmployeeCount Int     @default(0)
  totalAnnualWages   Decimal @default(0) @db.Decimal(18, 2)
  grossPremium       Decimal @default(0) @db.Decimal(16, 2)
  phcfAmount         Decimal @default(0) @db.Decimal(16, 2)
  itlAmount          Decimal @default(0) @db.Decimal(16, 2)
  stampDutyAmount    Decimal @default(0) @db.Decimal(16, 2)
  totalPremium       Decimal @default(0) @db.Decimal(16, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payrollRows WibaPayrollRow[]
}

model WibaPayrollRow {
  id           String            @id @default(cuid())
  wibaDetailId String
  wibaDetail   WibaSectionDetail @relation(fields: [wibaDetailId], references: [id], onDelete: Cascade)

  occupation    String
  employeeCount Int
  // Snapshotted result — always populated. For rows created before the
  // Basic Monthly Salary / Monthly Allowance fields existed (or edited
  // without touching them), this keeps its original manually-entered value
  // rather than being recomputed from nulls; see resolveWibaRowAnnualWages
  // in insuranceCalculations/wiba.ts for the exact fallback rule.
  annualWages   Decimal @db.Decimal(18, 2)
  sortOrder     Int     @default(0)

  // Optional inputs behind the Annual Salary formula
  // (basicMonthlySalary + monthlyAllowance) * employeeCount * 12. Nullable
  // because every row saved before this feature existed has neither — see
  // annualWages' doc comment above for how those old rows keep working.
  basicMonthlySalary Decimal? @db.Decimal(16, 2)
  monthlyAllowance   Decimal? @db.Decimal(16, 2)

  @@index([wibaDetailId])
}

model ElSectionDetail {
  id        String                    @id @default(cuid())
