model MedicalSectionDetail {
  id        String                    @id @default(cuid())
  sectionId String                    @unique
  section   QuotationInsuranceSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  inpatientLimit  Decimal @default(0) @db.Decimal(18, 2)
  outpatientLimit Decimal @default(0) @db.Decimal(18, 2)

  // Computed breakdown (snapshotted at save time). PHCF and ITL are always
  // zero for Group Medical per the approved template — stored explicitly
  // (rather than omitted) so the roll-up shape matches every other section.
  employeeCount     Int     @default(0)
  inpatientPremium  Decimal @default(0) @db.Decimal(16, 2)
  outpatientPremium Decimal @default(0) @db.Decimal(16, 2)
  subtotal          Decimal @default(0) @db.Decimal(16, 2)
  grossPremium      Decimal @default(0) @db.Decimal(16, 2)
  phcfAmount        Decimal @default(0) @db.Decimal(16, 2)
  itlAmount         Decimal @default(0) @db.Decimal(16, 2)
  stampDutyAmount   Decimal @default(0) @db.Decimal(16, 2)
  totalPremium      Decimal @default(0) @db.Decimal(16, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryRows MedicalFamilyCategoryRow[]
}

// Always exactly 6 rows (M, M+1..M+5), written/read in fixed sortOrder so
// the category ordering survives save/edit/reload — Phase 2B never allows
// arbitrary categories or a variable row count here (contrast with the
// fully dynamic WIBA/CPM/Marine/CustomsBond row patterns).
model MedicalFamilyCategoryRow {
  id              String                @id @default(cuid())
  medicalDetailId String
  medicalDetail   MedicalSectionDetail  @relation(fields: [medicalDetailId], references: [id], onDelete: Cascade)

  category         MedicalFamilyCategory
  employeeCount    Int     @default(0)
  inpatientRate    Decimal @default(0) @db.Decimal(10, 4)
  outpatientRate   Decimal @default(0) @db.Decimal(10, 4)
  inpatientAmount  Decimal @default(0) @db.Decimal(16, 2)
  outpatientAmount Decimal @default(0) @db.Decimal(16, 2)
  sortOrder        Int     @default(0)

  @@index([medicalDetailId])
}

